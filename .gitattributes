# Normalise line endings so checkouts on different machines don't show
# every file as modified.
* text=auto eol=lf

# Windows batch files only parse correctly with CRLF — a for/f loop silently
# fails to assign variables when the file has LF endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.gif binary
*.woff2 binary
*.zip binary
